[gd_resource type="Resource" script_class="TechDef" format=3]

[ext_resource type="Script" path="res://sim/defs/modifier_def.gd" id="1_mod"]
[ext_resource type="Script" path="res://sim/defs/tech_def.gd" id="2_tech"]

[sub_resource type="Resource" id="Mod_0"]
script = ExtResource("1_mod")
key = &"empire.station_build_time"
mode = 1
value = -150
scope = 1

[sub_resource type="Resource" id="Mod_1"]
script = ExtResource("1_mod")
key = &"planet.orbital_slots"
value = 1
scope = 2
condition = {
"planet_size": ["core:planet_size/large", "core:planet_size/huge"]
}

[resource]
script = ExtResource("2_tech")
branch = &"engineering"
tier = 3
cost = 2200
id = &"core:tech/engineering_station_engineering"
name_key = "TECH_ENGINEERING_STATION_ENGINEERING"
desc_key = "TECH_ENGINEERING_STATION_ENGINEERING_DESC"
modifiers = Array[ExtResource("1_mod")]([SubResource("Mod_0"), SubResource("Mod_1")])
